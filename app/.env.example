# Copy to .env and fill in. .env is gitignored — never commit real credentials.

DATABASE_URL=postgres://ehden_app:changeme@localhost:5432/ehden_vision
# 3001 — this is the online-testing port (proxy/3001/). Don't reuse 3000: that's
# tools/local-preview/server.js, and proxy/3000/ is abandoned as a testing target
# (see agents/runbook.md).
PORT=3001

# Session TTL in seconds — matches the Apps Script CacheService session TTL (6h).
SESSION_TTL_SECONDS=21600
# Password reset token TTL in seconds — matches the Apps Script version (1h).
RESET_TOKEN_TTL_SECONDS=3600

# --- Apps Script -> Node bridge (see agents/decisions.md "Open Decisions") ---
# Shared secret the Apps Script project sends as the X-Api-Key header on every UrlFetchApp
# call to /bridge/rpc/*. Generate with:  openssl rand -hex 32
# While unset, /bridge/rpc/* and /bridge/health return 503 (fail closed). Set the SAME value
# in the Apps Script project's Script Properties as API_SHARED_SECRET.
APPSCRIPT_SHARED_SECRET=
# Max JSON request body for /rpc and /bridge/rpc — bulk sheet-import calls need more than the
# 100kb express default.
RPC_BODY_LIMIT=5mb

# One-time data migration. While NOT "true", importLocatairesBundle (and any future
# import* RPC) refuses. Set to true only for the initial sheet->Postgres load, then
# unset and restart — a re-run while it's on TRUNCATEs and reloads, wiping API edits.
ALLOW_BULK_IMPORT=
