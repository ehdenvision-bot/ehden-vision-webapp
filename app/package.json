{
  "name": "ehden-vision-app",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + PostgreSQL rewrite of the Ehden Vision Apps Script app. Runs alongside `Webapp Files/` (untouched) during the migration.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1"
  }
}
